# Database Configuration
DATABASE_URL="postgres://postgres:postgres@localhost:5432/placar360"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-here-change-in-production"
JWT_EXPIRES_IN="7d"

# Email Configuration (SMTP) - For Notifications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password-here"
SMTP_FROM="Placar360 <your-email@gmail.com>"

# WhatsApp Business API Configuration - For Notifications
WHATSAPP_API_URL="https://graph.facebook.com/v18.0"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-business-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"
WHATSAPP_VERIFY_TOKEN="your-webhook-verify-token"

# Application Configuration
PORT=3000
NODE_ENV="development"

# Optional: Redis Configuration (for caching/session storage)
# REDIS_HOST="localhost"
# REDIS_PORT=6379
# REDIS_PASSWORD=""

# Optional: AWS Configuration (if using AWS services)
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Optional: File Upload Configuration
# MAX_FILE_SIZE="10485760" # 10MB in bytes
# UPLOAD_PATH="./uploads"
