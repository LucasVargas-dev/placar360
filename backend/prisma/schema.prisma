generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgres://postgres:postgres@localhost:5432/placar360"
}

model Person {
  id        Int       @id @default(autoincrement())
  name      String
  email     String?   @unique
  phone     String?
  cpf       String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  deletedAt DateTime?
  user      User?
}

model User {
  id                      String                   @id @default(cuid())
  code                    String?
  email                   String                   @unique
  cpf                     String?
  password                String?
  phone                   String?
  avatarUrl               String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  personId                Int                      @unique
  bookingsAsTeacher       Booking[]                @relation("BookingTeacher")
  bookings                Booking[]
  notifications           Notification[]
  notificationPreferences NotificationPreferences?
  tournaments             Tournament[]             @relation("TournamentOrganizer")
  tournamentParticipants  TournamentParticipant[]
  person                  Person                   @relation(fields: [personId], references: [id])
  userClubs               UserClub[]
  userHasRoles            UserHasRole[]
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  permissions RolePermission[]
  userHasRoles UserHasRole[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  resource    String
  action      String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now())
  deletedAt   DateTime?
  roles       RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

model UserHasRole {
  userId       String
  roleId       Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  user         User      @relation(fields: [userId], references: [id])
  role         Role      @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model Club {
  id           String        @id @default(cuid())
  createdBy    String?
  name         String
  description  String?
  phone        String?
  email        String?
  addressLine  String?
  city         String?
  state        String?
  timezone     String?       @default("UTC")
  openTime     String?
  closeTime    String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  courts       Court[]
  pricingRules PricingRule[]
  clubHasTournaments ClubHasTournament[]
  userClubs    UserClub[]
}

model Court {
  id                 String        @id @default(cuid())
  clubId             String
  name               String
  sportType          String
  surface            String?
  defaultSlotMinutes Int
  hourlyRate         Decimal?
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?
  bookings           Booking[]
  club               Club          @relation(fields: [clubId], references: [id])
  pricingRules       PricingRule[]
}

model State {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  uf        String   @unique
  region    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cities    City[]
}

model City {
  id        Int      @id @default(autoincrement())
  name      String
  stateId   Int
  ibgeCode  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  state     State    @relation(fields: [stateId], references: [id])

  @@unique([name, stateId])
  tournaments Tournament[]
}

model Booking {
  id               String         @id @default(cuid())
  courtId          String
  userId           String
  type             String
  startTime        DateTime
  endTime          DateTime
  status           String
  totalAmount      Decimal?
  recurringPattern Int?
  recurringEndDate DateTime?
  blockoutReason   String?
  notes            String?
  tournamentId     String?
  teacherId        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  court            Court          @relation(fields: [courtId], references: [id])
  teacher          User?          @relation("BookingTeacher", fields: [teacherId], references: [id])
  tournament       Tournament?    @relation(fields: [tournamentId], references: [id])
  user             User           @relation(fields: [userId], references: [id])
  notifications    Notification[]
  tournamentMatch  TournamentMatch? @relation("BookingMatch")
}

model PricingRule {
  id        String    @id @default(cuid())
  clubId    String
  courtId   String?
  name      String
  dayOfWeek Int
  startTime Int
  endTime   Int
  price     Decimal
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  club      Club      @relation(fields: [clubId], references: [id])
  court     Court?    @relation(fields: [courtId], references: [id])
}

model ClubHasTournament {
  clubId       String
  tournamentId String
  club         Club      @relation(fields: [clubId], references: [id])
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@id([clubId, tournamentId])
}

model Tournament {
  id                String                  @id @default(cuid())
  cityId            Int?
  organizerId       String
  name              String
  description       String?
  sportType         String
  startDate         DateTime
  endDate           DateTime
  registrationStart DateTime
  registrationEnd   DateTime
  maxParticipants   Int?
  status            String
  prizes            String?
  format            String                  @default("knockout")
  entryFee          Decimal?                @db.Decimal(10, 2)
  isActive          Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?
  bookings          Booking[]
  notifications     Notification[]
  city              City?                   @relation(fields: [cityId], references: [id])
  organizer         User                    @relation("TournamentOrganizer", fields: [organizerId], references: [id])
  participants      TournamentParticipant[]
  matches           TournamentMatch[]

  clubHasTournaments ClubHasTournament[]
}

model TournamentParticipant {
  id           String     @id @default(cuid())
  tournamentId String
  userId       String
  registeredAt DateTime   @default(now())
  status       String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
  matchEntries TournamentMatchParticipant[]

  @@unique([tournamentId, userId])
}

model TournamentMatch {
  id                   String                       @id @default(cuid())
  tournamentId         String
  bookingId            String?                      @unique
  round                String
  roundOrder           Int
  stageType            String
  groupName            String?
  modality             String?
  matchFormat          String?
  status               String                       @default("scheduled")
  scheduledAt          DateTime?
  winnerParticipantId  String?
  scoreSummary         String?
  format               String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  deletedAt            DateTime?
  tournament           Tournament                   @relation(fields: [tournamentId], references: [id])
  booking              Booking?                     @relation("BookingMatch", fields: [bookingId], references: [id])
  participants         TournamentMatchParticipant[]
}

model TournamentMatchParticipant {
  id                      String                 @id @default(cuid())
  matchId                 String
  tournamentParticipantId String
  position                Int
  seed                    Int?
  teamName                String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  match                   TournamentMatch        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participant             TournamentParticipant  @relation(fields: [tournamentParticipantId], references: [id])
}

model UserClub {
  id               String    @id @default(cuid())
  userId           String
  clubId           String
  relationshipType String
  specialties      String[]
  hourlyRate       Decimal?
  bio              String?
  experience       String?
  certifications   String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  club             Club      @relation(fields: [clubId], references: [id])
  user             User      @relation(fields: [userId], references: [id])

  @@unique([userId, clubId])
}

model Notification {
  id           String      @id @default(cuid())
  userId       String
  type         String
  channel      String
  title        String
  message      String
  data         Json?
  sentAt       DateTime?
  scheduledFor DateTime?
  status       String
  tournamentId String?
  bookingId    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  booking      Booking?    @relation(fields: [bookingId], references: [id])
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])
  user         User        @relation(fields: [userId], references: [id])
}

model NotificationPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique
  emailEnabled          Boolean  @default(true)
  whatsappEnabled       Boolean  @default(true)
  matchReminders        Boolean  @default(true)
  matchResults          Boolean  @default(true)
  tournamentUpdates     Boolean  @default(true)
  tournamentStarting    Boolean  @default(true)
  bookingConfirmations  Boolean  @default(true)
  bookingCancellations  Boolean  @default(true)
  reminderMinutesBefore Int      @default(60)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id])
}
